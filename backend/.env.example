# ── ChefKart Platform Configuration ──────────────────────────────────────────
# Copy this file to .env and customize for your environment.
# Local JSON mode works without any .env file or MongoDB.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1
NODE_ENV=development
# Set to "true" behind a reverse proxy (nginx, AWS ALB, Cloudflare)
TRUST_PROXY=false

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty for local JSON persistence (single-process, development only).
# For MongoDB: mongodb://127.0.0.1:27017/chefkart
# For Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/chefkart
MONGODB_URI=

# ── Authentication ───────────────────────────────────────────────────────────
# In development, a persistent local signing key is auto-generated.
# In production (NODE_ENV=production), this MUST be set to a random
# value of at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ── Seeding ──────────────────────────────────────────────────────────────────
# Set "false" when starting with a real, empty production database.
SEED_DATA=true

# ── Logging ──────────────────────────────────────────────────────────────────
# Levels: error, warn, info, debug
LOG_LEVEL=info

# ── Graceful Shutdown ────────────────────────────────────────────────────────
# Maximum milliseconds to wait for in-flight requests during shutdown.
SHUTDOWN_TIMEOUT_MS=10000
