{
  "name": "chefkart-platform",
  "version": "4.0.0",
  "private": true,
  "description": "ChefKart — Home Cook Discovery & Booking Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "test:mongo": "node scripts/test-mongo.mjs",
    "admin": "npm run admin --workspace backend",
    "dev:mongo": "node scripts/mongo.mjs dev",
    "start:mongo": "node scripts/mongo.mjs start",
    "admin:mongo": "node scripts/mongo.mjs admin",
    "db:catalog": "echo Run: mongosh \"mongodb://127.0.0.1:27017/chefkart_catalog\" --file backend/scripts/service-catalog.mongosh.js",
    "db:chef-crud": "node backend/scripts/chef-crud-demo.cjs"
  }
}
